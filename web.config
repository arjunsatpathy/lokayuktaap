<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <system.webServer>
        <security>
            <requestFiltering allowDoubleEscaping="true" allowHighBitCharacters="true">
                <fileExtensions allowUnlisted="true" />
                <verbs>
                    <add verb="OPTIONS" allowed="false" />
                </verbs>
            </requestFiltering>
        </security>
        <rewrite>
            <rules>
                <rule name="HTTPS Redirect" stopProcessing="true">
                    <match url=".*" />
                    <conditions>
                        <add input="{HTTPS}" pattern="^OFF$" />
                    </conditions>
                    <action type="Redirect" url="https://lokayukta.arunachal.gov.in" appendQueryString="false" />
                </rule>
            </rules>
            <outboundRules>
                <rule name="ASP Version">
                    <match serverVariable="RESPONSE_X-ASPNET-VERSION" pattern=".*" />
                    <action type="Rewrite" />
                </rule>
                <rule name="IIS Version">
                    <match serverVariable="RESPONSE_SERVER" pattern=".*" />
                    <action type="Rewrite" />
                </rule>
            </outboundRules>
        </rewrite>
        <httpProtocol>
            <customHeaders>
                <remove name="X-Powered-By" />
                <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
                <add name="Strict-Transport-Security" value="max-age=63072000; includeSubDomains; preload" />
                <add name="Permissions-Policy" value="geolocation=(), camera=(), microphone=()" />
                <add name="X-XSS-Protection" value="1; mode=block" />
                <add name="Content-Security-Policy" value="default-src ‘self’;" />
                <add name="X-Content-Type-Options" value="nosniff " />
                <add name="X-Frame-Options" value="DENY" />
            
            </customHeaders>
        </httpProtocol>
    </system.webServer>
</configuration>
